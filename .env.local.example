# ============================================================
# Ostrune SEO & Site Configuration — copy to .env.local
# ============================================================

# --- Site identity ---
# Canonical production URL used by sitemap.xml, robots.txt, metadata,
# and the dynamically generated Open Graph images (/og). No trailing slash.
# Used by: lib/seo.ts, app/sitemap.ts, app/robots.ts, app/og/route.tsx, and all page metadatas.
NEXT_PUBLIC_SITE_URL=https://ostrune.netlify.app

# The brand name shown in <title>, og:site_name, JSON-LD schemas,
# and the /og image generator (top-left watermark).
NEXT_PUBLIC_SITE_NAME=Ostrune

# --- Supabase (CMS / leads database) ---
# Supabase project URL — Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co

# Supabase anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service_role (secret) - SERVER ONLY (used by API routes).
# NEVER expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Email notifications ---
# Resend API key for sending transactional/lead notification emails.
RESEND_API_KEY=re_your_resend_api_key

# Sender address for notification emails (must match a verified sending domain).
RESEND_FROM_EMAIL=Ostrune Leads <noreply@yourdomain.com>

# --- Google Analytics (optional) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX